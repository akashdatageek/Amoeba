{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'cd \"$CLAUDE_PROJECT_DIR\" && { [ -x .venv/bin/python ] && P=.venv/bin/python || P=python3; } && $P tools/arch_update.py --background' >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
