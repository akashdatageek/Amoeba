#!/bin/sh
# D55: after every commit, rebuild the as-built page if anything it is built from changed (in the background, so the
# commit returns at once; output in runs/arch_update.log). Installed with: git config core.hooksPath tools/hooks
cd "$(git rev-parse --show-toplevel)" || exit 0
if [ -x .venv/bin/python ]; then PY=.venv/bin/python; else PY=python3; fi
"$PY" tools/arch_update.py --background >/dev/null 2>&1
exit 0
