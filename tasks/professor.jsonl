{"id": "prof-loan", "prompt": "What is the monthly payment on a $250,000 equipment loan at 7% APR over 5 years with monthly payments? Show the formula.", "rubric": {"required_deliverables": [{"name": "the amortisation formula", "any_of": ["P\\s*[×x*]?\\s*\\(?\\s*r", "\\(1\\s*\\+\\s*r\\)\\s*\\^?\\s*n", "1\\s*-\\s*\\(1\\s*\\+\\s*r\\)\\s*\\^?\\s*-\\s*n", "annuity|amorti[sz]ation formula"]}], "expected_numbers": [{"name": "monthly payment", "value": 4950.3, "unit": "USD", "tolerance": 0.0005}]}, "family": "professor", "tags": ["professor"]}
{"id": "prof-primes", "prompt": "Write and run a Python program that finds all prime numbers below 10,000. Report how many there are and the largest one.", "rubric": {"required_deliverables": [{"name": "Python code", "any_of": ["def \\w+\\(|for \\w+ in range|```python"]}], "expected_numbers": [{"name": "count of primes below 10,000", "value": 1229, "unit": "", "tolerance": 0.0}, {"name": "largest prime below 10,000", "value": 9973, "unit": "", "tolerance": 0.0}]}, "family": "professor", "tags": ["professor"]}
{"id": "prof-xlsx", "prompt": "Turn this shipment data into an Excel file with a totals row and a formula for average revenue per load: Lane A: 12 loads, $1,850 avg; Lane B: 7 loads, $2,400 avg; Lane C: 20 loads, $1,420 avg; Lane D: 4 loads, $3,100 avg.", "rubric": {"required_deliverables": [{"name": "an .xlsx file named", "any_of": ["\\.xlsx"]}, {"name": "a totals row", "any_of": ["total"]}, {"name": "an average-revenue formula", "any_of": ["=\\s*[A-Z]+\\d+\\s*/\\s*[A-Z]+\\d+", "average revenue per load"]}], "expected_numbers": [{"name": "total loads", "value": 43, "unit": "", "tolerance": 0.0}, {"name": "total revenue", "value": 79800, "unit": "USD", "tolerance": 0.0}, {"name": "average revenue per load", "value": 1855.81, "unit": "USD", "tolerance": 0.0005}]}, "family": "professor", "tags": ["professor"]}
{"id": "prof-ceo", "prompt": "Who is the current CEO of Maersk, and since when? Cite your source.", "rubric": {"required_deliverables": [{"name": "a start date or year", "any_of": ["\\b(19|20)\\d\\d\\b"]}, {"name": "a cited source", "any_of": ["\\[S\\d+\\]", "https?://"]}], "must_not": [{"name": "a CEO statement with no source", "pattern": "CEO", "unless_nearby": "\\[S\\d+\\]|https?://|\\[unverified\\]", "window": 400}]}, "family": "professor", "tags": ["professor"]}
{"id": "prof-diesel", "prompt": "Find today's average US diesel price from a cited source. Then compute fuel cost at 6.5 mpg for three legs: Chicago–Indianapolis 185 miles, Indianapolis–Columbus 175 miles, Columbus–Pittsburgh 185 miles, and put the legs, gallons and costs into an Excel file with a total row using formulas.", "rubric": {"required_deliverables": [{"name": "a cited diesel price", "any_of": ["\\$\\s?\\d\\.\\d{2,4}[^\\n]{0,80}(\\[S\\d+\\]|https?://)", "(\\[S\\d+\\]|https?://)[^\\n]{0,80}\\$\\s?\\d\\.\\d{2,4}"]}, {"name": "an .xlsx file named", "any_of": ["\\.xlsx"]}, {"name": "a total row", "any_of": ["total"]}], "expected_numbers": [{"name": "gallons Chicago–Indianapolis / Columbus–Pittsburgh", "value": 28.46, "unit": "", "tolerance": 0.001}, {"name": "gallons Indianapolis–Columbus", "value": 26.92, "unit": "", "tolerance": 0.001}, {"name": "total gallons", "value": 83.85, "unit": "", "tolerance": 0.001}]}, "family": "professor", "tags": ["professor"]}
