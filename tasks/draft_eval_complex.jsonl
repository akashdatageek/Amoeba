{"id": "db-choice", "prompt": "Our 12-person startup must choose between PostgreSQL and MongoDB for a new multi-tenant analytics product. Gather current benchmark results and managed-service pricing on AWS and GCP; estimate the monthly cost for 50 tenants at 200 GB each with a peak of 5,000 queries per minute; assess GDPR data-residency implications for our EU tenants; prototype and test an event and dashboard schema in both databases; and deliver a recommendation memo with a risk table and a 90-day migration plan.", "family": "freeform", "tags": ["complex", "needs-tool", "multi-role"], "rubric": {"required_deliverables": [{"name": "recommendation memo", "any_of": ["recommend"]}, {"name": "risk table", "any_of": ["risk (table|register|matrix)", "\\|\\s*risk\\b"]}, {"name": "90-day migration plan", "any_of": ["90[- ]day", "days? (1|0)\\s?[-–]\\s?30\\b"]}, {"name": "GDPR residency assessment", "any_of": ["GDPR"]}, {"name": "benchmark results", "any_of": ["benchmark"]}, {"name": "schema prototype", "any_of": ["schema"]}, {"name": "monthly cost on AWS and GCP", "any_of": ["(AWS|GCP|Google Cloud)[^\\n]{0,200}(per month|/\\s?mo|monthly)", "(per month|/\\s?mo|monthly)[^\\n]{0,200}(AWS|GCP|Google Cloud)"]}], "expected_numbers": [{"name": "total storage (50 x 200 GB)", "value": 10, "unit": "TB"}], "constraints_to_respect": [{"name": "12-person team", "any_of": ["12[- ]person", "team of 12", "12 (engineers|people|staff)", "small team"]}, {"name": "EU data residency", "any_of": ["EU (data )?residen", "data residency", "EU region", "eu-(west|central|north)", "europe-(west|north)"]}, {"name": "5,000 queries per minute peak", "any_of": ["5,?000 (queries|qpm)", "83(\\.3)? (queries per second|qps)"]}], "must_not": [{"name": "price without a source", "pattern": "(?:price[sd]?|pricing|costs?|retail|MSRP|list)[^.\\n]{0,40}?(?:US\\$|\\$|€|USD|EUR)\\s?\\d[\\d,]*(?:\\.\\d+)?", "unless_nearby": "source|according to|as of|https?://|\\[\\d+\\]|cited|pricing page|calculator|assum"}]}}
{"id": "clickstream-pipeline", "family": "freeform", "tags": ["complex", "needs-tool", "multi-role"], "prompt": "We ingest 30 million clickstream events per day, about 2 KB each, from Kafka. Build a nightly pipeline that loads them into a cloud warehouse, removes duplicate events, computes daily active users per country, and pages the on-call engineer if the job finishes more than 30 minutes late. Choose and justify the tools, write the transformation code and test it on a sample of real-looking data, estimate warehouse storage for one year of raw events, and deliver a runbook for the on-call engineer.", "rubric": {"required_deliverables": [{"name": "tool choice with justification", "any_of": ["(chose|choose|choice|select|recommend)\\w*[^\\n]{0,120}(because|since|due to|justif)", "justif"]}, {"name": "transformation code", "any_of": ["```\\s*(sql|python|scala)", "\\bSELECT\\b[\\s\\S]{0,400}\\bGROUP BY\\b"]}, {"name": "deduplication", "any_of": ["dedup", "duplicate"]}, {"name": "daily active users per country", "any_of": ["(DAU|daily active users)[^\\n]{0,80}country", "country[^\\n]{0,80}(DAU|daily active users)"]}, {"name": "tests on sample data", "any_of": ["test[^\\n]{0,80}sample", "sample[^\\n]{0,80}test", "unit test"]}, {"name": "on-call runbook", "any_of": ["runbook"]}], "expected_numbers": [{"name": "raw volume per day (30M x 2 KB)", "value": 60, "unit": "GB"}, {"name": "one year of raw events", "value": 21.9, "unit": "TB"}], "constraints_to_respect": [{"name": "page on-call if > 30 minutes late", "any_of": ["30[- ]min"]}, {"name": "source is Kafka", "any_of": ["kafka"]}, {"name": "nightly batch", "any_of": ["nightly", "daily (batch|job|schedule)", "cron"]}], "must_not": [{"name": "price without a source", "pattern": "(?:price[sd]?|pricing|costs?|retail|MSRP|list)[^.\\n]{0,40}?(?:US\\$|\\$|€|USD|EUR)\\s?\\d[\\d,]*(?:\\.\\d+)?", "unless_nearby": "source|according to|as of|https?://|\\[\\d+\\]|cited|pricing page|calculator|assum"}]}}
{"id": "ebike-us-entry", "family": "freeform", "tags": ["complex", "needs-tool", "multi-role"], "prompt": "A European e-bike maker with EUR 40 million annual revenue wants to enter the US market within 18 months. The US e-bike market is about USD 2.0 billion a year and the company targets a 0.5% share in its first year. Research the current US import tariffs on e-bikes made in the EU and in Asia, the retail pricing of the three largest competitors, UL 2849 certification requirements and state-level e-bike class laws; estimate first-year US revenue; and deliver a go/no-go memo with a phased entry plan, a first-year cost estimate and the top risks.", "rubric": {"required_deliverables": [{"name": "go/no-go memo", "any_of": ["go\\s?/\\s?no[- ]go", "no[- ]go", "\\bgo decision"]}, {"name": "phased entry plan", "any_of": ["phase (1|one|i)\\b", "phased"]}, {"name": "first-year cost estimate", "any_of": ["(first|1st)[- ]year cost", "year[- ]?(1|one) cost", "cost estimate"]}, {"name": "top risks", "any_of": ["risk"]}, {"name": "UL 2849 requirements", "any_of": ["UL\\s?2849"]}, {"name": "state class laws", "any_of": ["class (1|2|3|I{1,3})\\b", "three[- ]class"]}, {"name": "import tariffs EU and Asia", "any_of": ["tariff[\\s\\S]{0,300}(asia|china|taiwan|vietnam)", "(asia|china|taiwan|vietnam)[\\s\\S]{0,300}tariff"]}, {"name": "competitor retail pricing", "any_of": ["competitor[\\s\\S]{0,300}(price|pricing|MSRP)", "(price|pricing|MSRP)[\\s\\S]{0,300}competitor"]}], "expected_numbers": [{"name": "first-year US revenue (0.5% of USD 2.0B)", "value": 10000000, "unit": "USD"}], "constraints_to_respect": [{"name": "18-month entry window", "any_of": ["18[- ]month"]}, {"name": "0.5% first-year share", "any_of": ["0\\.5\\s?%"]}, {"name": "company scale EUR 40M revenue", "any_of": ["(EUR|€)\\s?40\\s?(million|m\\b|M\\b)", "40\\s?(million|M) (EUR|euro)"]}], "must_not": [{"name": "price without a source", "pattern": "(?:price[sd]?|pricing|costs?|retail|MSRP|list)[^.\\n]{0,40}?(?:US\\$|\\$|€|USD|EUR)\\s?\\d[\\d,]*(?:\\.\\d+)?", "unless_nearby": "source|according to|as of|https?://|\\[\\d+\\]|cited|pricing page|calculator|assum"}, {"name": "tariff rate without a source", "pattern": "\\d+(?:\\.\\d+)?\\s?%[^.\\n]{0,30}(?:tariff|dut(?:y|ies))|(?:tariff|dut(?:y|ies))[^.\\n]{0,30}?\\d+(?:\\.\\d+)?\\s?%", "unless_nearby": "source|according to|as of|https?://|\\[\\d+\\]|cited|pricing page|calculator|assum"}]}}
